    "version": "0.2.0",
    "configurations": [
        {
            "name": "Run Lambda",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}\\backend\\cmd\\lambda",
            "cwd": "${workspaceFolder}\\backend",
            "env": {
                "DEBUG": "true"
            }
        },
        {
            "name": "Run local",
            "type": "go",
            "request": "launch",
            "mode": "debug",
            "program": "${workspaceFolder}\\backend\\cmd\\local",
            "cwd": "${workspaceFolder}\\backend",
            "env": {
                "DEBUG": "true"
            }
        }
    ]
}
